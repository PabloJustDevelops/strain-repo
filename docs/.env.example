# Variables de entorno publicas (EXPO_PUBLIC_*)
# Copialo a ../.env y rellena los valores

# Entorno Supabase (opcional, solo si quieres sync entre dispositivos)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Configuracion de la app
EXPO_PUBLIC_APP_NAME=Strain
EXPO_PUBLIC_DEFAULT_REST_SECONDS=90
EXPO_PUBLIC_DEFAULT_UNITS=kg

# Variables EAS (privadas, no se commitean)
# EXPO_TOKEN=
