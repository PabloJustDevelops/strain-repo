# Configuración pnpm para el repo Strain.
# Mantenemos un único workspace (sin monorepo todavía), pero el archivo
# deja la puerta abierta a añadir paquetes compartidos en `packages/` más adelante.

# Instala solo dependencias del workspace raíz, no recursivamente.
ignore-workspace-root-check=true

# Resolución estricta: si dos paquetes piden versiones diferentes
# de la misma dependencia, falla en vez de coger una "intermedia".
# Esto evita el clásico "funciona en local, peta en CI".
strict-peer-dependencies=false
auto-install-peers=true

# El cliente nativo de Expo necesita hoisting. Con esto respetamos
# los límites del monorepo pero seguimos exponiendo paquetes
# transitivos al root.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Reusa el store de pnpm en CI para acelerar builds.
# (Solo aplica si el runner lo tiene configurado.)
store-dir=.pnpm-store

# Resolución por defecto: preferimos la última versión disponible
# dentro del rango declarado en package.json. No toca versionados
# manuales como victory-native, react-native-reanimated, etc.
resolution-mode=highest
