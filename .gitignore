# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Lockfiles: usamos bun (bun.lock), el resto se ignora
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build de Lynx: bundles y salida del target web
dist/
web-build/
*.local

# Native
ios/
android/
*.orig.*

# Host nativo (specs/001). La regla `android/` de arriba ignora cualquier carpeta
# llamada así, en cualquier nivel; el host vive en `host/android/` y sí se
# versiona (D15: versionado desde el ticket 1).
!host/android/

