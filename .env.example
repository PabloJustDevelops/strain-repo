# Variables de entorno públicas (EXPO_PUBLIC_*)
# Cópialo a .env y rellena los valores

# Entorno Supabase (opcional, solo si quieres sync entre dispositivos)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Configuración de la app
EXPO_PUBLIC_APP_NAME=Strain
EXPO_PUBLIC_DEFAULT_REST_SECONDS=90
EXPO_PUBLIC_DEFAULT_UNITS=kg

# Variables EAS (privadas, NO se commitean)
# EXPO_TOKEN=
