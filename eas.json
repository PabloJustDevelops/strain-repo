{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.x",
      "env": {
        "STRAIN_ENV": "base"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "STRAIN_ENV": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "STRAIN_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
