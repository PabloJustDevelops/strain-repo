{
  "name": "strain",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0 && bun run lint:anti-slop",
    "lint:anti-slop": "oxlint -c .oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "build:web": "expo export -p web",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:production": "npx eas-cli@latest build --platform all --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^7.0.4",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "victory-native": "^36.9.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@oxlint/plugins": "1.82.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "~19.2.14",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.26.0",
    "eslint-config-expo": "~57.0.2",
    "oxlint": "1.82.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "private": true,
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "unrs-resolver"
  ]
}
